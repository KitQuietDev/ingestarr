# IngestArr environment configuration
# Copy to .env — never commit .env to git

# === Required ===
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# === LLM (Ollama, OpenRouter, or any OpenAI-compatible endpoint) ===
# Local Ollama:
OLLAMA_URL=http://192.168.1.131:11434
OLLAMA_MODEL=gemma3:27b
OLLAMA_API_KEY=ollama
# Other local models that work well: qwen3.5:32b, gemma4:27b
# OpenRouter (cloud, cheap — uncomment and set key):
# OLLAMA_URL=https://openrouter.ai/api
# OLLAMA_MODEL=google/gemma-3-27b-it
# OLLAMA_API_KEY=sk-or-v1-your-key-here

# === Download Clients (at least one required) ===
SABNZBD_URL=http://localhost:8081
SABNZBD_API_KEY=

QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# === *Arr Apps (optional — enable hand-off mode for each media type) ===
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

SONARR_URL=http://localhost:8989
SONARR_API_KEY=

LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=
LIDARR_MODE=handoff

READARR_URL=http://localhost:8787
READARR_API_KEY=
READARR_ENABLED=false

# === Behavior ===
PROCESS_DELAY_SECONDS=30
SEARCH_DELAY_SECONDS=5
FALLBACK_TO_DIRECT=false
LOG_LEVEL=INFO

# === Download paths (for direct mode) ===
BOOKS_DOWNLOAD_PATH=/books
AUDIOBOOKS_DOWNLOAD_PATH=/audiobooks
INPUT_DIR=/data/input
STATE_DIR=/data/state
LOG_DIR=/data/logs
REVIEW_DIR=/data/review
